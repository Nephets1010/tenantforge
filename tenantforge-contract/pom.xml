<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.nephets</groupId>
    <artifactId>tenantforge</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tenantforge-contract</artifactId>
  <name>tenantforge-contract</name>
  <description>
    跨模块共享契约：租户值对象 Tenant、解析器接口 TenantResolver、隔离相关异常
    （TenantNotResolvedException / TenantUnknownException）。零运行时依赖（仅 JDK 21），
    被 core / store / starter 共同依赖，是整库对外的「接口面」。
  </description>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/package-info.java</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <properties>
    <!--
      contract 是纯值对象 / 接口 / 异常，逻辑密集且极易被测试完全覆盖；
      设 0.70 作为「契约层必须充分自测」的硬门槛（纯逻辑模块可 ≥ 0.60）。
    -->
    <jacoco.line.minimum>0.70</jacoco.line.minimum>
    <jacoco.report.skip>false</jacoco.report.skip>
  </properties>
</project>
