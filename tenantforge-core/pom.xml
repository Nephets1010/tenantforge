<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.nephets</groupId>
    <artifactId>tenantforge</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tenantforge-core</artifactId>
  <name>tenantforge-core</name>
  <description>
    纯 Java（零 Spring）核心运行时：租户上下文 TenantContext（InheritableThreadLocal + 虚拟线程显式传播）
    与各类租户解析器（Header / JWT Claim / Subdomain / Composite）。依赖 contract 提供的契约类型，仅额外引入 slf4j-api。
  </description>

  <!--
    ★ 本模块严禁引入任何 org.springframework.* 依赖。
      CI 的 architecture-boundaries job 用 grep 扫描编译期源码，出现 org.springframework.* 即失败。
  -->
  <dependencies>
    <!-- 跨模块共享契约（值对象 / 解析器接口 / 异常），包名保持 io.github.nephets.tenantforge.core 以避免破坏已有 import。 -->
    <dependency>
      <groupId>io.github.nephets</groupId>
      <artifactId>tenantforge-contract</artifactId>
    </dependency>
    <!-- 仅引入日志门面 slf4j-api（版本由 Spring Boot 父 POM 统一管理）；不引入任何绑定/实现，保持 core 零运行时强依赖。 -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/package-info.java</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <properties>
    <jacoco.line.minimum>${jacoco.line.minimum.core}</jacoco.line.minimum>
    <jacoco.report.skip>false</jacoco.report.skip>
  </properties>
</project>
